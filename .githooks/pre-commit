#!/bin/bash
# I18N-13, уровень 2: перед коммитом ловим строку интерфейса, у которой нет пути
# перевода (не обёрнута и в .po её нет), и новый msgid без записи в каталогах.
# Ставится один раз: bash scripts/install-git-hooks.sh
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

# Область та же, что у i18n_quickcheck: живой код приложения и шаблоны.
# (scripts/ и docs/ исключены: там литералы _("…") — примеры в подсказках.)
FILES=$(git diff --cached --name-only --diff-filter=ACM -- 'apps/*.py' 'apps/*.html' \
        'templates/*.html' 'config/*.py' | grep -vE '/(migrations|tests)/' || true)
# Грабля 2026-10-26 (повтор T-3, E10 батч 2): несортированный импорт в ТЕСТЕ ушёл в CI —
# ruff смотрит все проиндексированные .py, включая тесты (миграции — как в CI, через exclude).
PYFILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)

RUN="uv run python"
command -v uv >/dev/null 2>&1 || RUN="python3"

fail=0
if [ -n "$PYFILES" ] && command -v uv >/dev/null 2>&1; then
  # shellcheck disable=SC2086
  uv run -q ruff check --force-exclude $PYFILES || fail=1
  # shellcheck disable=SC2086
  uv run -q ruff format --check --force-exclude $PYFILES || fail=1
fi
if [ -z "$FILES" ]; then
  [ "$fail" = "0" ] && exit 0
  echo "Коммит остановлен: ruff (см. выше). Исправить: uv run ruff check --fix . && uv run ruff format ." >&2
  exit 1
fi
# shellcheck disable=SC2086
$RUN scripts/i18n_untranslated.py --check --files $FILES || fail=1
# shellcheck disable=SC2086
$RUN scripts/i18n_quickcheck.py $FILES || fail=1

# Грабля 2026-10-26 (повтор WR-6/7): шаблон с новым Tailwind-классом без пересборки
# app.css роняет CI-замок свежести. Пересобираем и сверяем с ИНДЕКСОМ.
if echo "$FILES" | grep -qE '\.html$' && command -v npm >/dev/null 2>&1 && [ -d node_modules ]; then
  npm run -s build:css >/dev/null 2>&1
  if ! git diff --quiet -- static/css/app.css; then
    echo "app.css устарел для этих шаблонов: git add static/css/app.css" >&2
    fail=1
  fi
fi

if [ "$fail" != "0" ]; then
  echo
  echo "Коммит остановлен: см. подсказки выше." >&2
  echo "Осознанно пропустить (контент/демо/правовое): git commit --no-verify" >&2
  exit 1
fi
