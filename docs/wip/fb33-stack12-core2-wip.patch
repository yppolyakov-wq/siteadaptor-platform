+#: не входит, формы «this» нет (у строки одного объекта — слова его вида).
+_SHARED_TYPE_WORDS = {
+    "event_detail": {
+        "every": gettext_lazy("bei jeder Veranstaltung und Reise"),
+        "all": gettext_lazy("bei allen Veranstaltungen und Reisen"),
+    },
+}
+
