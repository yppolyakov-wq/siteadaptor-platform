msgid_plural "%(counter)s Produkte im Feed"
msgstr[0] "%(counter)s товар у фіді"
msgstr[1] "%(counter)s товари у фіді"
msgstr[2] "%(counter)s товарів у фіді"
msgstr[3] "%(counter)s товару у фіді"

#: apps/publishing/merchant_feed
msgid "Aus Google-Profil übernehmen"
msgstr "Взяти з профілю Google"

#: apps/publishing/merchant_feed
msgid "Bitte zuerst das Google-Profil verbinden und einen Standort wählen."
msgstr "Спершу підключіть профіль Google і виберіть точку."

#: apps/publishing/merchant_feed
msgid "Denselben Code hier eintragen."
msgstr "Вкажіть тут той самий код."

#: apps/publishing/merchant_feed
msgid ""
"Ein zweiter Feed meldet Google, welche Produkte in Ihrem Geschäft vorrätig "
"sind."
msgstr ""
"Другий фід повідомляє Google, які товари є в наявності у вашому магазині."

#: apps/publishing/merchant_feed
msgid "Google ordnet die Shopcodes bis zu 24 Stunden nach der Verknüpfung zu."
msgstr "Google зіставляє коди магазинів протягом 24 годин після зв'язування."

